# ──────────────────────────────────────────────────────────────
#  Aksa Backend – Ortam Değişkenleri
#  ⚠️  Bu dosyayı .env olarak kopyala ve kendi değerlerini gir:
#      cp .env.example .env
# ──────────────────────────────────────────────────────────────

# PostgreSQL
# Kendi PostgreSQL bağlantı bilgilerini gir
# Örnek: postgresql://KULLANICI_ADIN@localhost:5432/aksa
DATABASE_URL=postgresql://KULLANICI_ADIN@localhost:5432/aksa

# JWT
JWT_SECRET=aksa-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# SMTP (Gmail)
# Gmail'de "Uygulama Şifresi" oluşturman gerekiyor
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=GMAIL_ADRESIN@gmail.com
SMTP_PASSWORD=GMAIL_UYGULAMA_SIFREN

# Uygulama
APP_NAME=AKSA
DEBUG=true

# Google OAuth
# Bu değeri Yavuz'dan al
GOOGLE_CLIENT_ID=GOOGLE_CLIENT_ID_BURAYA
