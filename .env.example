# AKSA – Ortam Değişkenleri (Root)
# ⚠️  Bu dosyayı .env olarak kopyala:
#     cp .env.example .env

# Gmail SMTP (E-posta doğrulama için)
# Bu değerleri Yavuz'dan al
SMTP_EMAIL=GMAIL_ADRES_BURAYA
SMTP_PASSWORD=GMAIL_UYGULAMA_SIFRESI_BURAYA

# Google OAuth (Sign-In)
# Bu değerleri Yavuz'dan al
GOOGLE_CLIENT_ID=GOOGLE_CLIENT_ID_BURAYA
GOOGLE_CLIENT_SECRET=GOOGLE_CLIENT_SECRET_BURAYA
GOOGLE_IOS_CLIENT_ID=GOOGLE_IOS_CLIENT_ID_BURAYA
